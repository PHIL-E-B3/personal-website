---
import '../styles/global.css';
import manual from '../data/contributions.json';

const USER = 'PHIL-E-B3';
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

// live GitHub activity (public feed, no token) merged with manual entries
let daily = [];
try {
  const r = await fetch(`https://github-contributions-api.jogruber.de/v4/${USER}?y=last`);
  if (r.ok) { const j = await r.json(); daily = j.contributions || []; }
} catch (e) { /* build still succeeds if the feed is down */ }

const byDate = {};
for (const d of daily) byDate[d.date] = (byDate[d.date] || 0) + (d.count || 0);
for (const m of manual) byDate[m.date] = (byDate[m.date] || 0) + (m.count || 1);

const now = new Date();
const months = [];
for (let i = 0; i < 12; i++) {
  const dt = new Date(now.getFullYear(), now.getMonth() - i, 1);
  const key = `${dt.getFullYear()}-${String(dt.getMonth()+1).padStart(2,'0')}`;
  let count = 0;
  for (const k in byDate) if (k.startsWith(key)) count += byDate[k];
  months.push({ label: MONTHS[dt.getMonth()], year: dt.getFullYear(), count });
}
const siteData = { months };

const { title = 'Philip Bunford', page = 'home' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<script is:inline>
  // set theme before paint to avoid flash
  try { const t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch(e){}
</script>
</head>
<body>
  <canvas id="plexus" aria-hidden="true"></canvas>
  <div id="scrim"></div>

  <div class="cluster">
    <nav class="topnav">
      <a href="/" class={page==='home'?'here':''}>Home</a>
      <a href="/about" class={page==='about'?'here':''}>About</a>
    </nav>
    <button class="bw" id="bw" aria-label="Toggle black / white"><span class="bw-knob"><span class="ic ic-bw"></span></span></button>
  </div>

  <main class="content">
    <slot />
  </main>

  <nav id="rail" aria-label="Monthly activity"></nav>
  <div id="tip"></div>

  <script id="site-data" type="application/json" set:html={JSON.stringify(siteData)}></script>
  <script is:inline src="/plexus.js"></script>
</body>
</html>
