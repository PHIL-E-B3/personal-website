---
import '../styles/global.css';
import manual from '../data/contributions.json';

const USER = 'PHIL-E-B3';
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const START_YEAR = 2022;

// fetch contributions for each year from START_YEAR to current
const now = new Date();
const currentYear = now.getFullYear();
const byDate = {};

for (let year = START_YEAR; year <= currentYear; year++) {
  try {
    const r = await fetch(`https://github-contributions-api.jogruber.de/v4/${USER}?y=${year}`);
    if (r.ok) {
      const j = await r.json();
      const daily = j.contributions || [];
      for (const d of daily) byDate[d.date] = (byDate[d.date] || 0) + (d.count || 0);
    }
  } catch (e) { /* build still succeeds if the feed is down */ }
}

// merge manual entries
for (const m of manual) byDate[m.date] = (byDate[m.date] || 0) + (m.count || 1);

// build monthly data for each year
const yearData = {};
for (let year = START_YEAR; year <= currentYear; year++) {
  const months = [];
  const isCurrentYear = year === currentYear;
  const monthCount = isCurrentYear ? now.getMonth() + 1 : 12;

  for (let month = monthCount - 1; month >= 0; month--) {
    const key = `${year}-${String(month + 1).padStart(2,'0')}`;
    let count = 0;
    for (const k in byDate) if (k.startsWith(key)) count += byDate[k];
    months.push({ label: MONTHS[month], month: month, year, count });
  }

  yearData[year] = months;
}

const siteData = { yearData, currentYear, startYear: START_YEAR };

const { title = 'Philip Bunford', page = 'home' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<script is:inline>
  // set theme before paint to avoid flash
  try { const t = localStorage.getItem('theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch(e){}
</script>
</head>
<body>
  <canvas id="plexus" aria-hidden="true"></canvas>
  <div id="scrim"></div>

  <div class="cluster">
    <nav class="topnav">
      <a href="/" class={page==='home'?'here':''}>Home</a>
      <a href="/about" class={page==='about'?'here':''}>About</a>
    </nav>
    <button class="bw" id="bw" aria-label="Toggle black / white"><span class="bw-knob"><span class="ic ic-bw"></span></span></button>
  </div>

  <main class="content">
    <slot />
  </main>

  <div id="year-selector" aria-label="Year selector"></div>
  <nav id="rail" aria-label="Monthly activity"></nav>
  <div id="tip"></div>

  <script id="site-data" type="application/json" set:html={JSON.stringify(siteData)}></script>
  <script is:inline src="/plexus.js"></script>
</body>
</html>
